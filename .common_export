# This file is linked as ~/.zshenv and is loaded by every zsh process.
# Keep it limited to fast, side-effect-free environment configuration.

typeset -gU path PATH
path=(
  "$HOME/.local/bin"
  "$HOME/.local/usr/bin"
  "$HOME/.local/opt/nvim/currVer/bin"
  "$HOME/.local/lang/volta/bin"
  "$HOME/.local/lang/cargo/bin"
  "$HOME/.local/lang/go/bin"
  "$HOME/.local/lang/rbenv/bin"
  "$HOME/.grok/bin"
  "$HOME/project/code/rust/scripts/target/x86_64-unknown-linux-musl/release"
  $path
)

# Node.js / Volta
export VOLTA_HOME="$HOME/.local/lang/volta"

# Python / uv
export UV_PYTHON_INSTALL_DIR="$HOME/.local/lang/uv"
export UV_TOOL_DIR="$HOME/.local/lang/uv/tools"
export UV_NO_MODIFY_PATH=1

# Rust
export CARGO_HOME="$HOME/.local/lang/cargo"
export RUSTUP_HOME="$HOME/.local/lang/rustup"

# Ruby / rbenv
export RBENV_ROOT="$HOME/.local/lang/rbenv"

# Editor
export EDITOR=nvim
export VISUAL=nvim

# Oracle client
export ORACLE_HOME="$HOME/package/oracle/instantclient_23_9"
export LD_LIBRARY_PATH="$ORACLE_HOME${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

# Static OpenSSL builds
export OPENSSL_LIB_DIR=/usr/local/musl/lib64
export OPENSSL_INCLUDE_DIR=/usr/local/musl/include
export OPENSSL_STATIC=true
export PKG_CONFIG_ALLOW_CROSS=1

# gtk4-rs
export PKG_CONFIG_PATH="/usr/lib/x86_64-linux-gnu/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"

# Kubernetes
export KUBECONFIG="$HOME/.kube/config"
