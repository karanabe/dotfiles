#!/usr/bin/env zsh
_dotfiles_root() {
	local record_file="$HOME/.local/.dotfiles"
	local repository_root
	if [[ ! -r "$record_file" ]]; then
		print -u2 -- "dotfiles path file not found: $record_file"
		return 1
	fi
	repository_root=$(<"$record_file")
	if [[ -z "$repository_root" || ! -d "$repository_root" ]]; then
		print -u2 -- "invalid dotfiles path in $record_file"
		return 1
	fi
	print -r -- "$repository_root"
}

# update
dotup() {
	local dotfiles_dir
	dotfiles_dir=$(_dotfiles_root) || return
	"$dotfiles_dir/update.sh" && source "$HOME/.zshrc"
}

# global
alias sudo='sudo '
dotfiles() {
	local dotfiles_dir
	dotfiles_dir=$(_dotfiles_root) || return
	cd -- "$dotfiles_dir"
}
alias lstat="stat --format='%a %A %10U %10G %20F %n' ./* .*"
alias lstats="stat --printf='%a %A %10U %10G %20F %n\n'"
alias lgrep="stat --format='%a %A %10U %10G %20F %n' ./* .* | grep"

# editor
alias vim='nvim'
alias vi='nvim'

# docker
alias dc="docker-compose"
alias dcu="docker-compose -p docker up -d"
alias dcd="docker-compose -p docker down"
alias dcs="docker-compose -p docker stop"
alias dstart="docker start"
alias dstop="docker stop"
dce() { docker-compose -p docker exec "$1" /bin/bash; }
de() { docker exec -it "$1" /bin/bash --login; }
alias drmi="docker rmi"
alias drm="docker rm"
alias di="docker images"
alias dcl="docker container ls -a"
alias dip="docker image prune"
alias dcp="docker container prune"
alias dv="docker volume"
