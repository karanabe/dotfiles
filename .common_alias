# tcpdump
alias tcpdump="sudo tcpdump"

# ps
alias psa="ps aux"

# ls
if (( $+commands[eza] )); then
	alias ls="eza --git --hyperlink --header"
	alias lsa="eza -la --git --hyperlink --header; pwd"
	alias ll="eza -l --git --hyperlink --header; pwd"
else
	alias lsa="ls -la; pwd"
	alias ll="ls -l; pwd"
fi

# terminal
alias cl="clear && pwd"

# less
alias less="/usr/bin/less"

# grep
alias rg="rg -g '!.git/' -g '!node_modules/'"

# cd
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias ~="cd ~"

# tar
alias tarxz="tar Jxf"
alias targz="tar zxf"

# git
alias cgit="chronogit"
alias gitinit="git commit --allow-empty -m 'initial commit'"
gitupstream() { git remote add upstream "$1"; }
gitupfetch() {
	git fetch upstream
	git checkout main
	git merge upstream/main
}
alias gitchmod="git update-index --add --chmod=+x"
alias ga="git add"
alias gb="git branch -a"
alias gc="git commit"
alias gs="git status"
alias gp="git push"
alias gpm="git push origin master"
alias gpf="git push -f"
alias gpfm="git push -f origin master"
alias gco="git checkout"
gpta() {
	if (( $# != 1 )); then
		print -u2 -- 'usage: gpta <patch-file>'
		return 2
	fi
	if ! git diff --quiet || ! git diff --cached --quiet; then
		print -u2 -- 'refusing to reset a repository with uncommitted changes'
		return 1
	fi
	local patch_file="./patch/$1"
	if [[ ! -f "$patch_file" ]]; then
		print -u2 -- "patch not found: $patch_file"
		return 1
	fi
	git reset --hard HEAD^ && git am --3way "$patch_file"
}
alias gsign="gitsign"
proot() { cd -- "$(git rev-parse --show-toplevel)"; }

# gpg
## Expire
## gedit XXXX
## key YYYY(Sub key)
## expire
## save
#
## gpg --with-keygrip --list-key
## rm ~/.gnupg/private-keys-v1.d/{keygrip}.key
alias gplist="gpg --list-keys --keyid-format LONG"
alias gpedit="gpg --expert --edit-key"
alias gpgen="gpg --expert --full-gen-key"
alias gprip="gpg --with-keygrip --list-key"
alias gpexp="gpg --armor --export"
alias gpexpsec="gpg --armor --export-secret-key"
gprm() {
	if (( $# != 1 )) || [[ -z "$1" || "$1" == *[^[:xdigit:]]* ]]; then
		print -u2 -- 'usage: gprm <hex-keygrip>'
		return 2
	fi
	rm -i -- "$HOME/.gnupg/private-keys-v1.d/$1.key"
}

# ssh
alias sshgen="ssh-keygen -t ed25519 -C"

# python / uv
alias von="source .venv/bin/activate"
alias voff='deactivate'
alias pip="uv pip"

# rust
cargobin() {
	if (( $# != 1 )) || [[ -z "$1" || "$1" == *[^A-Za-z0-9_-]* ]]; then
		print -u2 -- 'usage: cargobin <crate-name>'
		return 2
	fi
	git clone git@github.com:karanabe/rust-template.git "./$1" || return
	cd -- "$1" || return
	rm -rf -- .git
	git init
	git commit --allow-empty -m 'Init commit'
	while IFS= read -r file; do
		sed -i -e "s/rust-template/$1/g" "$file"
	done < <(grep -rl --exclude-dir=.git 'rust-template' .)
}

