#!/usr/bin/env bash
set -Eeuo pipefail

DOCKER_USER=${1:-kb}
DOCKER_COMMAND=${2:---login}
readonly IMAGE_NAME=kernelbuild:latest

if (( $# > 2 )); then
  printf 'usage: %s [container-user] [bash-argument]\n' "${0##*/}" >&2
  exit 2
fi

docker container run \
  --net=bridge \
  -v kernel:/home/kb/kernel \
  -v /tmp:/home/kb/tmp \
  -w /home/kb \
  -it --rm \
  -e TZ=Asia/Tokyo \
  -e TERM=xterm-256color \
  -e IS_DOCKER=true \
  --user "$DOCKER_USER" \
  --name kernel-build \
  --hostname KERNELBUILD \
  "$IMAGE_NAME" \
  /bin/bash "$DOCKER_COMMAND"
